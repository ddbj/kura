# staging 環境の値。SP の接続テストに使う。production と同じホストに置くので、
# compose の project 名を分けて起動する (docs/deployment.md)。
#
# secrets (KURA_STS_SIGNING_KEY / KURA_ROOT_ACCESS_KEY / KURA_ROOT_SECRET_KEY /
# KURA_FILER_JWT_KEY) と admin の Keycloak sub 一覧 (KURA_ADMIN_SUBS) は
# このファイルには入れない: gitignored な .env に置く。

# 前段 proxy の upstream と一致させる。production の port とは分ける
KURA_S3_PORT=28334
KURA_HTTP_PORT=28081

# 前段 proxy が別ホストから来るので loopback (compose の default) では届かない
KURA_BIND_ADDR=0.0.0.0

# DDBJ Keycloak の staging realm の `kura` client を使う
KURA_OIDC_ISSUER=https://idp-staging.ddbj.nig.ac.jp/realms/master
KURA_OIDC_CLIENT_ID=kura
KURA_OIDC_JWKS_URI=https://idp-staging.ddbj.nig.ac.jp/realms/master/protocol/openid-connect/certs

# 外向きの URL (TLS 終端は前段)
KURA_S3_ENDPOINT=https://kura-s3-staging.ddbj.nig.ac.jp

# 外向きの Host。列挙しない Host は配信 server が拒否する
KURA_ALLOWED_HOSTS=kura-staging.ddbj.nig.ac.jp

# UI の外向きの origin。robots.txt と sitemap.xml の絶対 URL になる
KURA_UI_ORIGIN=https://kura-staging.ddbj.nig.ac.jp

# production と同じ画面が検索結果に並ばないように、検索エンジンに載せない
KURA_NOINDEX=true

# S3 の CORS で許可する origin。認可は SigV4 (一時 credentials) だけで決まり、
# cookie を使わないので origin は認可の境界にならない。
KURA_S3_ALLOWED_ORIGINS=*

# volume 1 本のサイズ上限 (MB)。master は 30720 (= 30 GiB) を超える値を
# 起動時に弾くため、それ以下にする。
KURA_VOLUME_SIZE_LIMIT_MB=29000

# データのファイルシステムの空きの下限。下回ると全 volume が read-only になる。
# Lustre は共有なので、既定の 1% (数百 TB) ではなく容量で指定する
KURA_VOLUME_MIN_FREE_SPACE=100GiB

# 接続テストで置いたファイルを溜めないように、30 日で消す
KURA_FILE_TTL_DAYS=30

# 新規 bucket に適用する per-user quota。SPA の使用量メーターの分母にもなる
KURA_QUOTA_DEFAULT_MB=1048576

# SeaweedFS の /data 実体。production とは別の dir にする
KURA_SEAWEEDFS_DATA_DIR=/lustre9/open/home/w3ddbjld/kura-staging/data/seaweedfs

# コンテナの出力 (<service>.log) を書く dir。データ (Lustre) と別のディスクにし、
# production とも分ける
KURA_LOG_DIR=/data1/w3ddbjld/logs/kura-staging
